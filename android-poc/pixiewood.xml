<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/" xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="count">
    <xi:include href="src://data/io.github.mikaelamayhem.HighTideTvProbe.metainfo.xml" parse="xml"/>
  </metainfo>
  <style>
    <theme name="adw"/>
    <icon type="generate">
      <drawable target="foreground" scale=".5" type="svg" path="src://data/icon.svg"/>
      <color target="background">#1E1E2E</color>
    </icon>
  </style>
  <dependencies>
    <glib>
      <patch>hack</patch>
      <patch>pthread-restrictions</patch>
    </glib>
    <fontconfig/>
    <gtk>
      <!-- Our own patch: D-pad center and gamepad buttons (see patches/) -->
      <patch>gamepad-keys</patch>
    </gtk>
    <libadwaita/>
  </dependencies>
  <build target="hightide-tv-probe">
    <architectures>
      <arch>x86_64</arch>
      <arch>aarch64</arch>
    </architectures>
    <configure-options>
      <option>-Dgtk:media-gstreamer=disabled</option>
      <option>-Dgtk:buildtype=debugoptimized</option>
      <option>-Dgtk:print-cups=disabled</option>
      <option>-Dlibadwaita:tests=false</option>
      <option>-Dlibadwaita:examples=false</option>
    </configure-options>
  </build>
</app>
