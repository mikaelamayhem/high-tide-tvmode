<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="tidal">
	<schema id="io.github.nokse22.high-tide" path="/io/github/nokse22/tidal/">
	  <key name="window-width" type="i">
      <default>1000</default>
    </key>
    <key name="window-height" type="i">
      <default>800</default>
    </key>
	  <key name="quality" type="i">
      <default>2</default>
    </key>
	  <key name="last-playing-index" type="i">
      <default>-1</default>
    </key>
	  <key name="last-playing-thing-id" type="s">
      <default>''</default>
    </key>
	  <key name="last-playing-thing-type" type="s">
      <default>''</default>
    </key>
	  <key name="last-volume" type="i">
      <default>10</default>
    </key>
	  <key name="repeat" type="i">
      <default>0</default>
    </key>
	  <key name="preferred-sink" type="i">
	    <range min="0" max="6"/>
      <default>0</default>
    </key>
	  <key name="run-background" type="b">
      <default>false</default>
    </key>
	  <key name="normalize" type="b">
      <default>false</default>
    </key>
	  <key name="quadratic-volume" type="b">
      <default>false</default>
    </key>
	  <key name="app-id-change-understood" type="b">
      <default>false</default>
    </key>
	  <key name="video-covers" type="b">
      <default>true</default>
    </key>
	  <key name="discord-rpc" type="b">
      <default>true</default>
    </key>
	  <key name="alsa-device" type="s">
      <default>'default'</default>
    </key>
	  <key name="console-mode" type="b">
      <default>false</default>
      <summary>Console mode</summary>
      <description>Full screen, controller friendly layout for TVs and handhelds</description>
    </key>
	  <key name="console-scale" type="i">
      <range min="100" max="250"/>
      <default>150</default>
      <summary>Console mode scale</summary>
      <description>How much bigger the interface is in console mode, in percent</description>
    </key>
	  <key name="console-button-style" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="xbox"/>
        <choice value="playstation"/>
        <choice value="steamdeck"/>
      </choices>
      <default>'auto'</default>
      <summary>Controller button icons</summary>
      <description>Which controller's button icons to show in console mode</description>
    </key>
	  <key name="console-steam-keyboard" type="b">
      <default>true</default>
      <summary>Open Steam keyboard</summary>
      <description>In console mode, open Steam's on-screen keyboard when a text field is selected</description>
    </key>
	</schema>
</schemalist>
